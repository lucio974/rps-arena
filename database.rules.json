{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      ".read": "auth != null",
      ".indexOn": ["elo"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "collections": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "boxes": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "queue": {
      ".read": "auth != null",
      ".indexOn": ["waiting"],
      "$uid": {
        ".write": "auth != null"
      }
    },

    "matches": {
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "invites": {
      ".read": "auth != null",
      "$uid": {
        "$inviteId": {
          ".write": "auth != null"
        }
      }
    },

    "trades": {
      ".read": "auth != null",
      "$uid": {
        "$tradeId": {
          ".write": "auth != null"
        }
      }
    },

    "friendAdds": {
      ".read": "auth != null",
      "$uid": {
        "$fromUid": {
          ".write": "auth != null"
        }
      }
    }
  }
}
